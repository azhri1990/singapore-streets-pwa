{
  "name": "Singapore Streets",
  "short_name": "SG Streets",
  "description": "An original open-world game inspired by GTA: San Andreas, set in Singapore with authentic local architecture, vehicles, and road infrastructure.",
  "start_url": "./",
  "display": "fullscreen",
  "orientation": "landscape",
  "background_color": "#04111a",
  "theme_color": "#00ffff",
  "display_override": [
    "fullscreen",
    "standalone",
    "minimal-ui"
  ],
  "protocol_handlers": [
    {
      "protocol": "singapore",
      "url": "/?game=%s"
    }
  ],
  "share_target": {
    "action": "/",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "sharefile",
          "accept": ["image/*", "application/pdf", "text/*"]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "image/*": [".sgmap", ".png", ".jpg", ".jpeg"]
      }
    }
  ],
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "categories": ["games", "entertainment"],
  "screenshots": [
    {
      "src": "screenshot-1.png",
      "sizes": "1280x720",
      "type": "image/png"
    },
    {
      "src": "screenshot-2.png",
      "sizes": "1280x720",
      "type": "image/png"
    }
  ],
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "play",
      "id": "com.singapurasia.streets"
    }
  ]
}